{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paykesho-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "containers": [
    {
      "class_name": "PaykeshoWebContainer",
      "image": "./Dockerfile.cloudflare",
      "instance_type": "basic",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAYKESHO_WEB",
        "class_name": "PaykeshoWebContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PaykeshoWebContainer"
      ]
    }
  ],
  "secrets": {
    "required": [
      "PAYKESHO_DB_URL",
      "PAYKESHO_DB_USERNAME",
      "PAYKESHO_DB_PASSWORD"
    ]
  },
  "vars": {
    "NOTIFICATION_SERVICE_URL": "http://localhost:8085",
    "FILE_SERVICE_URL": "http://localhost:8086",
    "RATE_LIMITING_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
