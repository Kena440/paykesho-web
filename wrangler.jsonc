{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paykesho-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "containers": [
    {
      "class_name": "PaykeshoWebContainer",
      "image": "./Dockerfile.cloudflare",
      "instance_type": "basic",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAYKESHO_WEB",
        "class_name": "PaykeshoWebContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PaykeshoWebContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
