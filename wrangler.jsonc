{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paykesho-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "containers": [
    {
      "class_name": "PaykeshoWebContainer",
      "image": "./Dockerfile.cloudflare",
      "instance_type": "basic",
      "max_instances": 3
    },
    {
      "class_name": "PaykeshoClientContainer",
      "image": "./Dockerfile.client.cloudflare",
      "instance_type": "basic",
      "max_instances": 3
    },
    {
      "class_name": "PaykeshoPaymentContainer",
      "image": "./Dockerfile.payment.cloudflare",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAYKESHO_WEB",
        "class_name": "PaykeshoWebContainer"
      },
      {
        "name": "PAYKESHO_CLIENT",
        "class_name": "PaykeshoClientContainer"
      },
      {
        "name": "PAYKESHO_PAYMENT",
        "class_name": "PaykeshoPaymentContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PaykeshoWebContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PaykeshoClientContainer"
      ]
    }
  ],
  "secrets": {
    "required": [
      "PAYKESHO_DB_URL",
      "PAYKESHO_DB_USERNAME",
      "PAYKESHO_DB_PASSWORD",
      "PAYKESHO_ADMIN_EMAIL",
      "PAYKESHO_ADMIN_PASSWORD",
      "LENCO_API_TOKEN",
      "LENCO_ACCOUNT_ID",
      "PAYKESHO_INTERNAL_TOKEN"
    ]
  },
  "vars": {
    "NOTIFICATION_SERVICE_URL": "http://localhost:8085",
    "FILE_SERVICE_URL": "http://localhost:8086",
    "RATE_LIMITING_ENABLED": "true",
    "LENCO_API_BASE_URL": "https://api.lenco.co/access/v2",
    "PAYMENT_SERVICE_URL": "http://localhost:8787/internal/payment"
  },
  "observability": {
    "enabled": true
  }
}
