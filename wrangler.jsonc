{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paykesho-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    { "class_name": "ClientPortal", "name": "paykesho-client", "image": "./Dockerfile.cloudflare", "image_build_context": ".", "instance_type": "basic", "max_instances": 1 },
    { "class_name": "MerchantPortal", "name": "paykesho-merchant", "image": "./Dockerfile.cloudflare", "image_build_context": ".", "instance_type": "basic", "max_instances": 1 },
    { "class_name": "OrganizationPortal", "name": "paykesho-organization", "image": "./Dockerfile.cloudflare", "image_build_context": ".", "instance_type": "basic", "max_instances": 1 },
    { "class_name": "Backoffice", "name": "paykesho-backoffice", "image": "./Dockerfile.cloudflare", "image_build_context": ".", "instance_type": "basic", "max_instances": 1 },
    { "class_name": "PaymentService", "name": "paykesho-payment", "image": "./Dockerfile.cloudflare", "image_build_context": ".", "instance_type": "basic", "max_instances": 1 },
    { "class_name": "NotificationService", "name": "paykesho-notification", "image": "./Dockerfile.cloudflare", "image_build_context": ".", "instance_type": "basic", "max_instances": 1 },
    { "class_name": "FileService", "name": "paykesho-file", "image": "./Dockerfile.cloudflare", "image_build_context": ".", "instance_type": "basic", "max_instances": 1 }
  ],
  "durable_objects": { "bindings": [
    { "name": "PAYKESHO_CLIENT", "class_name": "ClientPortal" }, { "name": "PAYKESHO_MERCHANT", "class_name": "MerchantPortal" },
    { "name": "PAYKESHO_ORGANIZATION", "class_name": "OrganizationPortal" }, { "name": "PAYKESHO_BACKOFFICE", "class_name": "Backoffice" },
    { "name": "PAYKESHO_PAYMENT", "class_name": "PaymentService" }, { "name": "PAYKESHO_NOTIFICATION", "class_name": "NotificationService" },
    { "name": "PAYKESHO_FILE", "class_name": "FileService" }
  ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["ClientPortal", "MerchantPortal", "OrganizationPortal", "Backoffice", "PaymentService", "NotificationService", "FileService"] } ],
  "env": { "staging": { "name": "paykesho-platform-staging" } }
}
