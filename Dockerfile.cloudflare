# Cloudflare Containers requires linux/amd64.
FROM --platform=linux/amd64 eclipse-temurin:17-jdk-jammy AS build

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends maven \
    && rm -rf /var/lib/apt/lists/*

# Copy the complete Maven reactor before resolving dependencies.
# The root/webparent POMs declare multiple child modules, so copying
# only a subset of POM files causes Maven's reactor resolution to fail.
COPY . .

# Build only the client portal and the modules it actually depends on.
RUN mvn -B -pl webparent/client-portal -am clean package -DskipTests

FROM --platform=linux/amd64 eclipse-temurin:17-jre-jammy

WORKDIR /app

COPY --from=build /app/webparent/client-portal/target/*.jar /app/app.jar

ENV JAVA_OPTS="-Xmx768m -Xms256m"
ENV SPRING_PROFILES_ACTIVE="cloudflare"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
