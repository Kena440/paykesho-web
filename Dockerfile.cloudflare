# Cloudflare Containers requires linux/amd64.
FROM --platform=linux/amd64 maven:3.9.16-eclipse-temurin-17 AS build

WORKDIR /app
COPY . .

# Build the PayKesho BackOffice application used for administrator login.
RUN mvn -B -ntp -pl webparent/backoffice -am clean package \
    -DskipTests \
    -Djacoco.skip=true

FROM --platform=linux/amd64 eclipse-temurin:17-jre-jammy

WORKDIR /app
COPY --from=build /app/webparent/backoffice/target/*.jar /app/app.jar

ENV JAVA_OPTS="-Xmx512m -Xms128m -XX:MaxMetaspaceSize=192m"
ENV SPRING_PROFILES_ACTIVE="cloudflare"

EXPOSE 8080
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
