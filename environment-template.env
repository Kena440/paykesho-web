# Paykesho Environment Configuration Template
# Copy this file to .env and update with your actual values
# DO NOT commit .env files to version control

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=paykesho
MYSQL_USER=paykesho_user
MYSQL_PASSWORD=your_secure_db_password_here

# Application Secrets
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# OAuth Configuration (if using OAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Notification Service Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_email_username
SMTP_PASSWORD=your_email_password
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

# External Service URLs
PAYMENT_GATEWAY_URL=https://your-payment-gateway.com
PAYMENT_GATEWAY_API_KEY=your_payment_api_key
PAYMENT_GATEWAY_SECRET=your_payment_secret

# File Storage Configuration
FILE_STORAGE_PATH=/app/uploads
FILE_MAX_SIZE=10MB

# Security Configuration
SESSION_SECRET=your_session_secret_here
REMEMBER_ME_KEY=your_remember_me_key_here

# Monitoring and Health
HEALTH_CHECK_INTERVAL=30s
LOG_LEVEL=INFO
