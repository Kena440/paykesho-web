# PayKesho Environment Configuration Template
# Copy this file to .env / deployment secrets and replace every placeholder.
# NEVER commit real credentials.

# Supabase / PostgreSQL
# Use the Supabase Session Pooler JDBC URL from Dashboard -> Connect.
# Example format:
# jdbc:postgresql://[POOLER-HOST]:5432/postgres?user=postgres.[PROJECT-REF]&password=[YOUR-PASSWORD]&sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://[POOLER-HOST]:5432/postgres?user=postgres.[PROJECT-REF]&password=[YOUR-PASSWORD]&sslmode=require
SUPABASE_PROJECT_REF=fjfgjfprhtdanjohabuj

# Application Secrets
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
SESSION_SECRET=your_session_secret_here
REMEMBER_ME_KEY=your_remember_me_key_here

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Notification Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_username
SMTP_PASSWORD=your_email_password
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

# External Payment Service
PAYMENT_GATEWAY_URL=https://your-payment-gateway.com
PAYMENT_GATEWAY_API_KEY=your_payment_api_key
PAYMENT_GATEWAY_SECRET=your_payment_secret

# ZynlePay
ZYNLEPAY_MERCHANT_ID=your_merchant_id
ZYNLEPAY_API_ID=your_api_id
ZYNLEPAY_API_KEY=your_api_key
ZYNLEPAY_URL=https://sandbox.zynlepay.com/zynlepay/jsonapi

# File Storage Configuration
FILE_STORAGE_PATH=/app/uploads
FILE_MAX_SIZE=10MB

# Security / Operations
RATE_LIMITING_ENABLED=false
LOG_LEVEL=INFO
