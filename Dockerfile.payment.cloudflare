FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace

COPY pom.xml ./pom.xml
COPY commons ./commons
COPY webparent ./webparent

RUN mvn -pl webparent/payment-service -am -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /workspace/webparent/payment-service/target/payment-service-*.jar /app/payment-service.jar

EXPOSE 8084
ENTRYPOINT ["java","-jar","/app/payment-service.jar"]
